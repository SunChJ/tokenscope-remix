{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokenscope",
  "version": "1.5.6",
  "identifier": "com.tokenscope.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && bash src-tauri/bin/build-hu.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Tokenscope",
        "width": 400,
        "height": 660,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGREQ5QzhCQjc0QUIxNTYKUldSV3NVcTNpNXpkVDJvWTFpMUx6WEZialVXSXdyeDNSZnM5ZnMzK29NTThPUk5CVDVtWG02SjYK",
      "endpoints": [
        "https://github.com/SunChJ/tokenscope-remix/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": ["bin/hu"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
